# Local dev — 对接本机 Docker Blockscout（与 docker-compose/envs/common-frontend.env 对齐）
NEXT_PUBLIC_APP_PROTOCOL=http
NEXT_PUBLIC_APP_HOST=localhost
NEXT_PUBLIC_APP_PORT=3000
NEXT_PUBLIC_APP_ENV=development

NEXT_PUBLIC_API_HOST=localhost
NEXT_PUBLIC_API_PROTOCOL=http
NEXT_PUBLIC_API_BASE_PATH=/
NEXT_PUBLIC_API_WEBSOCKET_PROTOCOL=ws
NEXT_PUBLIC_STATS_API_HOST=http://localhost:8080
NEXT_PUBLIC_VISUALIZE_API_HOST=http://localhost:8081

NEXT_PUBLIC_NETWORK_NAME=AxBLADE Mainnet Blockchain 
NEXT_PUBLIC_NETWORK_SHORT_NAME=AxBLADE Mainnet Blockchain
NEXT_PUBLIC_HIDE_NETWORK_MENU=true
NEXT_PUBLIC_NETWORK_ID=11155111
NEXT_PUBLIC_NETWORK_CURRENCY_NAME=Ether
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=ETH
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18
NEXT_PUBLIC_NETWORK_RPC_URL=https://rpc-sepolia.babydriver.xyz
NEXT_PUBLIC_IS_TESTNET=true

NEXT_PUBLIC_HOMEPAGE_CHARTS=['daily_txs']
# 首页 Hero 背景（download_assets → public/assets/configs/homepage_hero_banner_background.png）
NEXT_PUBLIC_HOMEPAGE_HERO_BANNER_BACKGROUND=file://./deploy/assets/branding/hero-banner-background.png
NEXT_PUBLIC_API_SPEC_URL=https://raw.githubusercontent.com/blockscout/blockscout-api-v2-swagger/main/swagger.yaml

# 以下 URL 供 download_assets 使用（缺省会导致脚本跳过或失败时可从 configs/envs/.env.eth_sepolia 拷贝更多项）
NEXT_PUBLIC_FEATURED_NETWORKS=https://raw.githubusercontent.com/blockscout/frontend-configs/main/configs/featured-networks/eth.json
NEXT_PUBLIC_FOOTER_LINKS=https://raw.githubusercontent.com/blockscout/frontend-configs/main/configs/footer-links/sepolia.json
# 亮色 / 暗色字标：deploy/assets/branding/；dev 时 download_assets 复制到 public/assets/configs/
NEXT_PUBLIC_NETWORK_LOGO=file://./deploy/assets/branding/axblade-network-logo.svg
NEXT_PUBLIC_NETWORK_LOGO_DARK=file://./deploy/assets/branding/axblade-network-logo-dark.svg
# 侧栏收起：浅色 / 深色稿（download_assets → public/assets/configs/navigation_logo_collapsed*.svg）
NEXT_PUBLIC_NAVIGATION_LOGO_COLLAPSED=file://./deploy/assets/branding/navigation-logo-collapsed-light.svg
NEXT_PUBLIC_NAVIGATION_LOGO_COLLAPSED_DARK=file://./deploy/assets/branding/navigation-logo-collapsed-dark.svg
NEXT_PUBLIC_NETWORK_ICON=file://./deploy/assets/branding/navigation-logo-collapsed-light.svg 
NEXT_PUBLIC_NETWORK_ICON_DARK=file://./deploy/assets/branding/navigation-logo-collapsed-dark.svg
NEXT_PUBLIC_OG_IMAGE_URL=https://raw.githubusercontent.com/blockscout/frontend-configs/main/configs/og-images/sepolia-testnet.png

NEXT_PUBLIC_PREVIEW_CONNECT_BUTTON=true
NEXT_PUBLIC_PREVIEW_CONNECT_GLOW=true